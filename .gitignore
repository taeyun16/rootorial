# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# generated framework output
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local configuration and secrets
.env*
!.env.example
.dev.vars*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.output/
/.wrangler/
/outputs/
/work/
/.omx/
