# Clerk remains optional during local content work. Copy this file to `.env`
# and replace both values to enable sign-in, sign-up, and user sessions.
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Comma-separated Clerk user IDs allowed to post official answers and moderate.
# Keep this server-only. An empty value grants admin access to nobody.
ROOTORIAL_ADMIN_USER_IDS=user_replace_me
